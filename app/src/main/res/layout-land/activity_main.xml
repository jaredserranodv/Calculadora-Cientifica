<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <!-- Visor: ocupa todo el ancho arriba, igual que en portrait. -->
    <TextView
        android:id="@+id/display"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:gravity="end|center_vertical"
        android:singleLine="true"
        android:ellipsize="start"
        android:contentDescription="Resultado y expresión"
        android:text="0"
        android:textSize="32sp"
        android:paddingHorizontal="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Columna izquierda: funciones científicas, 3 columnas x 6 filas. -->
    <LinearLayout
        android:id="@+id/panelCientifico"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/panelNumerico"
        app:layout_constraintTop_toBottomOf="@id/display"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="sin" android:tag="sin(" android:onClick="onButtonClick" />
            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="cos" android:tag="cos(" android:onClick="onButtonClick" />
            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="tan" android:tag="tan(" android:onClick="onButtonClick" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="sin⁻¹" android:tag="asin(" android:onClick="onButtonClick" />
            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="cos⁻¹" android:tag="acos(" android:onClick="onButtonClick" />
            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="tan⁻¹" android:tag="atan(" android:onClick="onButtonClick" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="√" android:tag="sqrt(" android:onClick="onButtonClick" />
            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="xʸ" android:tag="^" android:onClick="onButtonClick" />
            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="log" android:tag="log(" android:onClick="onButtonClick" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="ln" android:tag="ln(" android:onClick="onButtonClick" />
            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="n!" android:tag="!" android:onClick="onButtonClick" />
            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="π" android:tag="π" android:onClick="onButtonClick" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="e" android:tag="e" android:onClick="onButtonClick" />
            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="%" android:tag="%" android:onClick="onButtonClick" />
            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="(" android:tag="(" android:onClick="onButtonClick" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text=")" android:tag=")" android:onClick="onButtonClick" />
            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="C" android:tag="C" android:onClick="onButtonClick" />
            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="⌫" android:tag="DEL" android:onClick="onButtonClick" />
        </LinearLayout>
    </LinearLayout>

    <!-- Columna derecha: teclado numérico y operadores básicos, 4 columnas x 4 filas. -->
    <LinearLayout
        android:id="@+id/panelNumerico"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintStart_toEndOf="@id/panelCientifico"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/display"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="7" android:tag="7" android:onClick="onButtonClick" />
            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="8" android:tag="8" android:onClick="onButtonClick" />
            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="9" android:tag="9" android:onClick="onButtonClick" />
            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="÷" android:tag="÷" android:onClick="onButtonClick" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="4" android:tag="4" android:onClick="onButtonClick" />
            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="5" android:tag="5" android:onClick="onButtonClick" />
            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="6" android:tag="6" android:onClick="onButtonClick" />
            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="×" android:tag="×" android:onClick="onButtonClick" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="1" android:tag="1" android:onClick="onButtonClick" />
            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="2" android:tag="2" android:onClick="onButtonClick" />
            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="3" android:tag="3" android:onClick="onButtonClick" />
            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="−" android:tag="−" android:onClick="onButtonClick" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="0" android:tag="0" android:onClick="onButtonClick" />
            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="." android:tag="." android:onClick="onButtonClick" />
            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="=" android:tag="=" android:onClick="onButtonClick" />
            <Button style="@style/CalculatorButton" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="+" android:tag="+" android:onClick="onButtonClick" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
